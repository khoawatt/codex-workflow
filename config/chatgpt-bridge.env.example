# ChatGPT bridge auto-login — copy to ~/.config/codex-work/chatgpt-web/.env then chmod 600.
# Shell env (CHATGPT_EMAIL / CHATGPT_PASSWORD) takes precedence over this file.
# Never commit the real .env (contains password).
CHATGPT_EMAIL=you@example.com
CHATGPT_PASSWORD=your-password-here
# Aliases also accepted: OPENAI_EMAIL / OPENAI_PASSWORD
# Optional: TOTP 2FA secret (base32, from your authenticator app enrollment) for
# fully automatic login — the bridge generates the 6-digit code locally, the
# secret never leaves this machine and never appears in logs. Without it, the
# bridge waits for you to type the code manually (up to 20 min).
# Aliases also accepted: OPENAI_TOTP_SECRET
# CHATGPT_TOTP_SECRET=JBSWY3DPEHPK3PXP
# Custom path override: CHATGPT_ENV_FILE=/path/to/.env chatgpt-consult login --auto
