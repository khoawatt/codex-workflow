# Gemini bridge auto-login — copy to ~/.config/codex-work/gemini-web/.env then chmod 600.
# Shell env (GEMINI_EMAIL / GEMINI_PASSWORD) takes precedence over this file.
# Never commit the real .env (contains password).
GEMINI_EMAIL=you@gmail.com
GEMINI_PASSWORD=your-password-here
# Aliases also accepted: GOOGLE_EMAIL / GOOGLE_PASSWORD
# Custom path override: GEMINI_ENV_FILE=/path/to/.env gemini-review login --auto
# Note: Google accounts with 2-Step Verification / passkeys, or CAPTCHA /
# "browser may not be secure" interstitials, still need one manual `login`.
